rules_version = '2';
// Niesen Cup – Firestore-Sicherheitsregeln
// In der Firebase-Konsole unter Firestore Database → Regeln komplett einfügen und „Veröffentlichen“.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'luigi.nobile80@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function notAnon() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if notAnon() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'at']);
      allow delete: if isAdmin();
    }

    match /tournaments/{tid} {
      allow read: if signedIn();
      allow write: if isAdmin();

      function t() { return get(/databases/$(database)/documents/tournaments/$(tid)).data; }
      function regOpen() { return t().status == 'open' && request.time.toMillis() < t().regDeadline; }

      match /players/{pid} {
        allow read: if signedIn();
        allow create: if isAdmin() || (signedIn() && request.auth.uid == pid && regOpen()
          && request.resource.data.keys().hasOnly(['name', 'vote', 'createdAt', 'present'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
          && request.resource.data.present == false
          && (request.resource.data.vote == null || request.resource.data.vote in t().options));
        allow update: if isAdmin() || (signedIn() && request.auth.uid == pid && regOpen()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vote'])
          && request.resource.data.vote in t().options);
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == pid && regOpen());
      }

      // Freie Wahl: ein Dokument pro Team → jedes Team nur einmal
      match /picks/{teamId} {
        allow read: if signedIn();
        allow create: if isAdmin() || (signedIn() && request.resource.data.pid == request.auth.uid
          && t().status == 'checkin' && t().distribution == 'choice'
          && exists(/databases/$(database)/documents/tournaments/$(tid)/players/$(request.auth.uid)));
        allow delete: if isAdmin() || (signedIn() && resource.data.pid == request.auth.uid && t().status == 'checkin');
      }

      // Draft: ein Dokument pro Pick-Runde
      match /draftPicks/{turn} {
        allow read: if signedIn();
        allow create: if isAdmin() || (signedIn() && t().status == 'draw' && t().draft != null
          && request.resource.data.pid == request.auth.uid
          && t().draft.order[t().draft.turn] == request.auth.uid
          && turn == string(t().draft.turn));
        allow delete: if isAdmin();
      }

      match /matches/{mid} {
        allow read: if signedIn();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (signedIn() && t().status == 'running'
          && request.auth.uid in [resource.data.home, resource.data.away]
          && (
            // Ergebnis melden (oder nach Streit neu melden)
            (resource.data.status in ['scheduled', 'live', 'disputed', 'reported']
              && request.resource.data.status == 'reported'
              && request.resource.data.reportedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hg', 'ag', 'ph', 'pa', 'status', 'reportedBy', 'reportedAt']))
            ||
            // Gegner bestätigt (nur Status ändern, Ergebnis bleibt)
            (resource.data.status == 'reported' && resource.data.reportedBy != request.auth.uid
              && request.resource.data.status == 'confirmed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']))
            ||
            // Gegner widerspricht
            (resource.data.status == 'reported' && resource.data.reportedBy != request.auth.uid
              && request.resource.data.status == 'disputed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          ));
      }
    }
  }
}
